<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html><head><title>Reports | EPMS</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4"></script></head><body><jsp:include page="/WEB-INF/views/header.jsp"/><main class="container page-shell">
<div class="page-heading d-flex justify-content-between align-items-end flex-wrap gap-3"><div><div class="eyebrow"><i class="bi bi-graph-up-arrow me-1"></i>INSIGHTS CENTER</div><h1>Performance reports</h1><p>Turn review data into clear, actionable insights.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i>Print</button><a class="btn btn-primary" href="${pageContext.request.contextPath}/reports.csv"><i class="bi bi-download"></i>Export CSV</a></div></div>
<div class="row g-4 mb-4"><div class="col-sm-4"><div class="card stat-card"><div class="d-flex justify-content-between"><span class="text-secondary">Departments tracked</span><i class="bi bi-building stat-icon"></i></div><div class="display-6 fw-bold mt-3">${report.departmentAverages.size()}</div><small class="text-secondary">Across your organization</small></div></div><div class="col-sm-4"><div class="card stat-card"><div class="d-flex justify-content-between"><span class="text-secondary">Top performers</span><i class="bi bi-trophy stat-icon"></i></div><div class="display-6 fw-bold mt-3">${report.topPerformers.size()}</div><small class="text-secondary">Recognized in this cycle</small></div></div><div class="col-sm-4"><div class="card stat-card"><div class="d-flex justify-content-between"><span class="text-secondary">Rating bands</span><i class="bi bi-bar-chart stat-icon"></i></div><div class="display-6 fw-bold mt-3">${report.distribution.size()}</div><small class="text-secondary">Available for analysis</small></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="card"><div class="card-header d-flex justify-content-between"><h2 class="h5 mb-0"><i class="bi bi-building me-2 text-primary"></i>Department averages</h2><span class="badge text-bg-light">Live data</span></div><div class="card-body"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Department</th><th>Average rating</th></tr></thead><tbody><c:forEach var="r" items="${report.departmentAverages}"><tr><td><c:out value="${r.name}"/></td><td><div class="d-flex align-items-center gap-2"><div class="progress flex-grow-1"><div class="progress-bar" style="width:${r.average * 20}%"></div></div><span class="badge text-bg-primary"><c:out value="${r.average}"/> / 5</span></div></td></tr></c:forEach></tbody></table></div></div></div></div><div class="col-lg-5"><div class="card"><div class="card-header"><h2 class="h5 mb-0"><i class="bi bi-bar-chart me-2 text-primary"></i>Rating distribution</h2></div><div class="card-body"><canvas id="ratings"></canvas></div></div></div></div>
<div class="card mt-4"><div class="card-header"><h2 class="h5 mb-0"><i class="bi bi-trophy me-2 text-warning"></i>Top performers</h2></div><div class="card-body"><ol class="mb-0"><c:forEach var="r" items="${report.topPerformers}"><li class="mb-2"><strong><c:out value="${r.name}"/></strong><span class="text-secondary"> — <c:out value="${r.average}"/> average rating</span></li></c:forEach><c:if test="${empty report.topPerformers}"><li class="text-secondary">No rated performers yet.</li></c:if></ol></div></div></main><jsp:include page="/WEB-INF/views/footer.jsp"/><script>new Chart(document.getElementById('ratings'),{type:'bar',data:{labels:[<c:forEach var="r" items="${report.distribution}" varStatus="s">${s.index > 0 ? ',' : ''}'<c:out value="${r.rating}"/>'</c:forEach>],datasets:[{label:'Reviews',backgroundColor:'#2563eb',borderRadius:6,data:[<c:forEach var="r" items="${report.distribution}" varStatus="s">${s.index > 0 ? ',' : ''}<c:out value="${r.count}"/></c:forEach>]}]},options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}}});</script></body></html>
