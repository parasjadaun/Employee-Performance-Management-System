<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html><head><title>Goals | EPMS</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><jsp:include page="/WEB-INF/views/header.jsp"/><main class="container page-shell">
<div class="page-heading"><div class="eyebrow"><i class="bi bi-bullseye me-1"></i>PERFORMANCE PLAN</div><h1>Goals</h1><p>Track progress and keep priorities visible.</p></div>
<div class="toolbar mb-3"><div class="input-group"><span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span><input class="form-control border-0" data-table-filter="#goalsTable" placeholder="Search goals, people, or due dates"></div></div>
<div class="card p-3"><div class="table-responsive"><table id="goalsTable" class="table"><thead><tr><th>Employee</th><th>Goal</th><th>Weight</th><th>Due</th><th style="min-width:180px">Progress</th></tr></thead><tbody><c:forEach var="g" items="${goals}"><tr><td><c:out value="${g.employee_name}"/></td><td><strong><c:out value="${g.title}"/></strong></td><td><c:out value="${g.weight}"/>%</td><td><c:out value="${g.due_date}"/></td><td><div class="d-flex align-items-center gap-2"><div class="progress flex-grow-1"><div class="progress-bar ${g.progress >= 75 ? 'bg-success' : g.progress >= 40 ? 'bg-warning' : 'bg-primary'}" style="width:${g.progress}%"></div></div><small class="fw-semibold"><c:out value="${g.progress}"/>%</small></div></td></tr></c:forEach><c:if test="${empty goals}"><tr><td colspan="5" class="empty-state"><i class="bi bi-bullseye fs-2 d-block mb-2"></i>No goals found for this view.</td></tr></c:if></tbody></table></div>
<c:if test="${sessionScope.user.role == 'EMPLOYEE'}"><div class="border-top pt-4 mt-2"><h2 class="h5"><i class="bi bi-sliders text-primary me-2"></i>Update goal progress</h2><form method="post" class="row g-3 mt-1"><input type="hidden" name="action" value="progress"><div class="col-md-4"><label class="form-label">Goal ID</label><input class="form-control" name="id" placeholder="Enter goal ID" required></div><div class="col-md-4"><label class="form-label">Progress</label><input class="form-control" name="progress" type="number" min="0" max="100" placeholder="0 - 100%" required></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100"><i class="bi bi-arrow-repeat"></i>Update progress</button></div></form></div></c:if></div></main><jsp:include page="/WEB-INF/views/footer.jsp"/></body></html>
<c:if test="${sessionScope.user.role == 'MANAGER'}"><div class="border-top pt-4 mt-2"><h2 class="h5"><i class="bi bi-plus-circle text-success me-2"></i>Assign a team goal</h2><form method="post" class="row g-3 mt-1"><div class="col-md-6"><label class="form-label">Employee</label><select class="form-select" name="employeeId" required><option value="">Choose an employee</option><c:forEach var="e" items="${employees}"><option value="${e.id}"><c:out value="${e.name}"/> · <c:out value="${e.email}"/></option></c:forEach></select><small class="text-secondary">Only existing employees are shown.</small></div><div class="col-md-6"><label class="form-label">Goal title</label><input class="form-control" name="title" placeholder="e.g. Improve customer response time" required></div><div class="col-md-4"><label class="form-label">Weight (%)</label><input class="form-control" name="weight" type="number" min="1" max="100" step="0.1" required></div><div class="col-md-4"><label class="form-label">Due date</label><input class="form-control" name="dueDate" type="date" required></div><div class="col-md-4"><label class="form-label">Description</label><input class="form-control" name="description" placeholder="Success criteria"></div><div class="col-12"><button class="btn btn-success"><i class="bi bi-bullseye"></i>Assign goal</button></div></form></div></c:if><c:if test="${sessionScope.user.role == 'EMPLOYEE'}"><div class="border-top pt-4 mt-2"><h2 class="h5"><i class="bi bi-sliders text-primary me-2"></i>Update goal progress</h2><form method="post" class="row g-3 mt-1"><input type="hidden" name="action" value="progress"><div class="col-md-4"><label class="form-label">Goal ID</label><input class="form-control" name="id" placeholder="Enter goal ID" required></div><div class="col-md-4"><label class="form-label">Progress</label><input class="form-control" name="progress" type="number" min="0" max="100" placeholder="0 - 100%" required></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100"><i class="bi bi-arrow-repeat"></i>Update progress</button></div></form></div></c:if></div></main><jsp:include page="/WEB-INF/views/footer.jsp"/></body></html>
