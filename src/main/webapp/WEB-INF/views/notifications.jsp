<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html><head><title>Notifications | EPMS</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><jsp:include page="/WEB-INF/views/header.jsp"/><main class="container page-shell">
<div class="page-heading d-flex justify-content-between align-items-end flex-wrap gap-3"><div><div class="eyebrow"><i class="bi bi-bell me-1"></i>ACTIVITY CENTER</div><h1>Notifications</h1><p>Stay informed about reviews and updates.</p></div><span class="badge rounded-pill text-bg-primary">${notifications.size()} updates</span></div>
<div class="toolbar mb-3"><div class="input-group"><span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span><input class="form-control border-0" data-table-filter="#notificationList" placeholder="Search notifications"></div></div><div class="card p-3"><div id="notificationList" class="list-group list-group-flush"><c:forEach var="n" items="${notifications}"><div class="list-group-item px-0 py-3 notification-item"><div class="d-flex gap-3"><span class="stat-icon"><i class="bi bi-info-circle"></i></span><div><strong><c:out value="${n.message}"/></strong><small class="text-secondary d-block mt-1"><i class="bi bi-clock me-1"></i><c:out value="${n.created_at}"/></small></div></div></div></c:forEach><c:if test="${empty notifications}"><div class="empty-state"><i class="bi bi-check2-circle text-success fs-2 d-block mb-2"></i>You’re all caught up.</div></c:if></div></div></main><jsp:include page="/WEB-INF/views/footer.jsp"/></body></html>
