<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html><head><title>Review Cycles | EPMS</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><jsp:include page="/WEB-INF/views/header.jsp"/><main class="container page-shell">
<div class="page-heading"><div class="eyebrow"><i class="bi bi-calendar3 me-1"></i>REVIEW OPERATIONS</div><h1>Review cycles</h1><p>Define the periods your organization uses for structured feedback.</p></div><div class="row g-4"><div class="col-lg-8"><div class="card p-3"><div class="table-responsive"><table class="table"><thead><tr><th>Cycle</th><th>Dates</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="c" items="${cycles}"><tr><td><strong><c:out value="${c.name}"/></strong></td><td><c:out value="${c.start_date}"/> – <c:out value="${c.end_date}"/></td><td><span class="badge ${c.status == 'OPEN' ? 'text-bg-success' : 'text-bg-secondary'}"><c:out value="${c.status}"/></span></td><td><c:if test="${c.status == 'OPEN'}"><form method="post" data-confirm="Close this review cycle?"><input type="hidden" name="action" value="close"><input type="hidden" name="id" value="${c.id}"><button class="btn btn-sm btn-outline-warning"><i class="bi bi-lock"></i>Close</button></form></c:if></td></tr></c:forEach><c:if test="${empty cycles}"><tr><td colspan="4" class="empty-state">No review cycles created yet.</td></tr></c:if></tbody></table></div></div></div><div class="col-lg-4"><div class="card"><div class="card-header"><h2 class="h5 mb-0"><i class="bi bi-plus-circle text-success me-2"></i>New cycle</h2></div><div class="card-body"><form method="post" class="row g-3"><div class="col-12"><label class="form-label">Cycle name</label><input class="form-control" name="name" placeholder="e.g. Q4 2026" required></div><div class="col-12"><label class="form-label">Start date</label><input class="form-control" type="date" name="startDate" required></div><div class="col-12"><label class="form-label">End date</label><input class="form-control" type="date" name="endDate" required></div><div class="col-12"><button class="btn btn-primary w-100"><i class="bi bi-calendar-plus"></i>Create cycle</button></div></form></div></div></div></div></main><jsp:include page="/WEB-INF/views/footer.jsp"/></body></html>
