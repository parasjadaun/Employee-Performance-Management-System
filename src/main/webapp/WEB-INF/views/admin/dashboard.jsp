<div class="col-md-6 col-xl-3"><a class="card action-card" href="${pageContext.request.contextPath}/admin/cycles"><div class="action-icon"><i class="bi bi-calendar3"></i></div><h2 class="h5">Review cycles</h2><p class="text-secondary mb-0">Open and close review periods.</p></a></div>
<div class="col-md-6 col-xl-3"><a class="card action-card" href="${pageContext.request.contextPath}/reports"><div class="action-icon"><i class="bi bi-bar-chart-line"></i></div><h2 class="h5">Reports</h2><p class="text-secondary mb-0">See company-wide performance trends.</p></a></div></div></main><jsp:include page="/WEB-INF/views/footer.jsp"/></body></html>
