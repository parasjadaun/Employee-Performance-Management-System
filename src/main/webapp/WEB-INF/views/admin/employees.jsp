<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html><head><title>Employees</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><jsp:include page="/WEB-INF/views/header.jsp"/><main class="container page-shell"><div class="page-heading"><h1><i class="bi bi-people text-primary me-2"></i>Employees</h1><p>Search and manage your organization’s people.</p></div>
<div class="toolbar mb-3"><form class="row g-2 align-items-center"><div class="col-md"><div class="input-group"><span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span><input class="form-control border-0" name="search" placeholder="Search by name or email" value="<c:out value='${param.search}'/>"></div></div><div class="col-auto"><button class="btn btn-primary"><i class="bi bi-search"></i>Search</button></div></form></div>
<div class="card p-3 mb-4"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Manager</th></tr></thead><tbody><c:forEach var="e" items="${employees}"><tr><td><strong><c:out value="${e.name}"/></strong></td><td><c:out value="${e.email}"/></td><td><span class="badge text-bg-light"><c:out value="${e.department}"/></span></td><td><c:out value="${e.manager}"/></td></tr></c:forEach><c:if test="${empty employees}"><tr><td colspan="4" class="empty-state">No employees match your search.</td></tr></c:if></tbody></table></div></div>
<div class="card"><div class="card-header"><h2 class="h5 mb-0"><i class="bi bi-person-plus text-success me-2"></i>Add employee</h2></div><div class="card-body"><form method="post" class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><input class="form-control" name="name" placeholder="e.g. Alex Morgan" required></div><div class="col-md-6"><label class="form-label">Work email</label><input class="form-control" type="email" name="email" placeholder="name@company.com" required></div><div class="col-md-4"><label class="form-label">Temporary password</label><input class="form-control" type="password" name="password" required></div><div class="col-md-4"><label class="form-label">Department</label><select class="form-select" name="departmentId" required><option value="">Choose department</option><c:forEach var="d" items="${departments}"><option value="${d.id}"><c:out value="${d.name}"/></option></c:forEach></select></div><div class="col-md-4"><label class="form-label">Manager</label><select class="form-select" name="managerId" required><option value="">Choose manager</option><c:forEach var="m" items="${managers}"><option value="${m.id}"><c:out value="${m.name}"/> · <c:out value="${m.email}"/></option></c:forEach></select></div><div class="col-12"><button class="btn btn-success"><i class="bi bi-person-plus"></i>Create employee</button></div></form></div></div>
<a class="btn btn-link px-0" href="${pageContext.request.contextPath}/dashboard"><i class="bi bi-arrow-left"></i>Back to dashboard</a></main><jsp:include page="/WEB-INF/views/footer.jsp"/></body></html>
